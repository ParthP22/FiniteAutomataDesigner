# Copy this file to .env.local and fill in your own values.

# Supabase
# The Supabase URL can be found under Settings > General.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The Supabase publishable key can be found under Settings > API Keys, under the
# "Legacy anon, service_role API keys" tab, as "anon public".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Note: values do not need quotes unless they contain spaces or special characters.
