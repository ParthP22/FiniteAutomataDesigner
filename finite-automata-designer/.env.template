# Copy this file to .env.local and fill in your own values.

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
#
# For LOCAL DEVELOPMENT (recommended for contributors):
#   1. Run `npx supabase start` (requires Docker running)
#   2. Run `npx supabase status` to print the values below
#   3. Copy them in as-is — no Supabase account or project access needed
#
# For PRODUCTION / hosted project values, find them in the Supabase
# dashboard under Settings > API Keys.

# Project URL.
# Local: printed as "API URL" by `supabase status` (usually http://127.0.0.1:54321).
# Hosted: Find the Project ID in Settings > General. The URL will be of the form
#   https://project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key — safe to expose to the browser.
# Local: printed as "Publishable key" by `supabase status`.
# Hosted: Settings > API Keys > "Legacy anon, service_role API keys" tab > "anon public".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Secret key — not currently read by the app itself. Only needed locally for
# admin-level tooling/scripts (e.g. seeding). Never expose to the browser.
# Local: printed as "Secret key" by `supabase status`.
# Hosted: not used.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Postgres connection string — not currently read by the app itself. Useful
# for connecting a DB client/GUI or running raw SQL directly.
# Local: printed as "DB URL" by `supabase status` (usually
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres).
# Hosted: not used.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Note: values do not need quotes unless they contain spaces or special characters.