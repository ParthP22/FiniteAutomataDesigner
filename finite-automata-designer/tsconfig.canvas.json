{
  // TypeScript config for the Rollup canvas bundles (rollup.*.config.js) only.
  //
  // @rollup/plugin-typescript runs a TypeScript *watch* program even for a
  // one-off build. Pointed at the root tsconfig.json, whose "**/*.ts" include
  // covers the whole project, that program watches .next/ as well; a running
  // `next dev` writes there constantly, and each write schedules a rebuild that
  // keeps Rollup alive after "created ...Canvas.js", so build:canvas / dev:all
  // never finish. Scoping the program to what the canvas actually compiles
  // keeps the watchers off .next/ (and off the bundles Rollup itself writes).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    // Nothing reads the .rollup.cache build info between runs
    "incremental": false
  },
  "include": [
    "public/scripts/**/*.ts",
    "src/lib/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
